APP_NAME=CATS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cats_final
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Staging / production: send through the Resend API (https://resend.com/docs/send-with-laravel)
# MAIL_MAILER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM_ADDRESS=no-reply@creativeabilitiestherapyservices.ca
# MAIL_FROM_NAME="Creative Abilities Therapy Services"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CATS_INTERVIEW_TIMEZONE=America/Edmonton
CATS_INTERVIEW_DURATION_MINUTES=60
CATS_NAME="Creative Abilities Therapy Services"
CATS_PHONE=
CATS_EMAIL=
CATS_ADDRESS=

# Phase 15 — external integrations. Unset in local/dev: document uploads
# fall back to local disk.
GOOGLE_DRIVE_CREDENTIALS_PATH=
SHARED_DRIVE_ID=

MAILCOW_API_URL=https://mail.creativeabilitiestherapyservices.ca/api/v1
MAILCOW_API_KEY=
MAILCOW_DEFAULT_DOMAIN=creativeabilitiestherapyservices.ca

# Local/dev mail goes through Mailtrap's sandbox SMTP (fill in your own
# inbox's username/password from Mailtrap's SMTP Settings tab — nothing
# actually gets delivered, it just lands in the sandbox inbox for testing).
#
# Production mail goes through the Mailcow-provisioned mailbox over SMTP:
# MAIL_HOST=mail.creativeabilitiestherapyservices.ca
# MAIL_PORT=587
# MAIL_USERNAME=noreply-cats@creativeabilitiestherapyservices.ca
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=noreply-cats@creativeabilitiestherapyservices.ca
